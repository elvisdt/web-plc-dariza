# Copia este archivo a .env (no se commitea) y pon los valores reales.

# Login de la web (validado en el navegador, no es seguridad real)
APP_USER=admin
APP_PASS=changeme

# Credenciales del broker MQTT real (usadas por el bridge, nunca llegan al navegador)
MQTT_REMOTE_HOST=pesajeapp.site
MQTT_REMOTE_PORT=1883
MQTT_REMOTE_USER=dispositivo
MQTT_REMOTE_PASS=changeme
